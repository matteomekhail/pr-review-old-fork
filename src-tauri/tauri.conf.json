{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PR Review",
  "version": "0.1.0",
  "identifier": "com.sunwrobert.prreview",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bunx vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PR Review",
        "width": 1480,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#0f1011",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src https:; frame-src https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src https:; frame-src https:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFOUU4NDk4N0RFOTE4Q0MKUldUTUdPbDltSVNlemsyVXRyOTVxYkV6cWRDVHBteFhHUGZ0QUNjenI1cEoyN0hLc0lWV3Zmb1MK",
      "endpoints": [
        "https://github.com/sunwrobert/pr-review/releases/latest/download/latest.json"
      ]
    }
  }
}
